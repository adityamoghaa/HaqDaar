# ─── HaqDaar Environment Configuration ──────────────────────
# Google Gemini API Key from Google AI Studio (Free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model:
# - gemini-2.5-flash (Default, fastest, native multimodal audio & 1M token context)
# - gemini-1.5-pro (Deep reasoning & complex profile extraction)
GEMINI_MODEL=gemini-2.5-flash

# App version
VITE_APP_VERSION=2.0.0
